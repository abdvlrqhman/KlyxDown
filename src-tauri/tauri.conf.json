{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KlyxDown",
  "version": "0.2.2",
  "identifier": "net.spacie.klyxdown",
  "build": {
    "beforeDevCommand": "node scripts/bridge.mjs && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/bridge.mjs --release && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KlyxDown",
        "width": 1060,
        "height": 680,
        "minWidth": 780,
        "minHeight": 500,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0C1320",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; media-src 'self' http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Spacie",
    "category": "Utility",
    "shortDescription": "Open-source download manager",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/klyxdown-bridge"
    ],
    "homepage": "https://spacie.net/klyxdown",
    "copyright": "Spacie",
    "license": "GPL-3.0-or-later",
    "fileAssociations": [
      {
        "ext": [
          "torrent"
        ],
        "name": "BitTorrent file",
        "description": "BitTorrent file",
        "role": "Viewer",
        "mimeType": "application/x-bittorrent"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAzQUQ1RUMwMjU4OTA4OUIKUldTYkNJa2x3RjZ0QThrSTRhMjQzaUdQSHlXYW1ldkxjTkdWT2xCZ3RlUVptQ241UnoxbVVrR0IK",
      "endpoints": [
        "https://github.com/abdvlrqhman/KlyxDown/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "magnet"
        ]
      }
    }
  }
}
